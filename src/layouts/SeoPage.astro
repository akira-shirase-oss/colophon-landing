---
// A published page of the `pages` collection (src/content.config.ts) in the one layout they all share,
// src/layouts/Page.astro: its fields, its rendered body, and the published words the document needs.
import { render } from 'astro:content'
import PageLayout from './Page.astro'
import { published, siteCopy } from '../lib/home'
import type { SeoPage } from '../lib/pages'

type Props = { page: SeoPage }
const { page } = Astro.props
const { Content } = await render(page)
---

<PageLayout id={page.id} data={page.data} statusLine={(await siteCopy()).status_line} {...await published()}>
  <Content />
</PageLayout>
