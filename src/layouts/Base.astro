---
// The document of every built page: Document.astro with the published words it needs (src/lib/home.ts).
import Document, { type Props as DocumentProps } from './Document.astro'
import { published } from '../lib/home'

type Props = Omit<DocumentProps, 'imageAlt' | 'generation'> & { imageAlt?: string }

const { imageAlt, generation } = await published()
---

<Document imageAlt={imageAlt} {...Astro.props} generation={generation}>
  <slot name="head" slot="head" />
  <slot />
</Document>
