---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Benefits from '../components/Benefits.astro'
import FAQ from '../components/FAQ.astro'
import Integrations from '../components/Integrations.astro'
import CTA from '../components/CTA.astro'
import Footer from '../components/Footer.astro'
import { hero } from '../data/hero'

const title = `Colophon | ${hero.headline.replace(/\.$/, '')}`
const description =
  'Colophon is a content management system where every publish becomes a numbered release, with a record of exactly what went live and where it was seen.'
---

<Base
  title={title}
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Colophon',
    url: Astro.site?.href,
    description,
  }}
>
    <div id="root">
      <div style="display: flex; flex-direction: column; align-items: center; overflow: clip;">
        <Nav />
        <main style="width: 100%; display: flex; flex-direction: column; align-items: center; margin-top: 1px; gap: var(--section-gap); padding-bottom: var(--section-gap);">
          <Hero />
          <Integrations />
          <Benefits />
          <FAQ />
          <CTA />
        </main>
        <Footer />
      </div>
    </div>
</Base>
