---
// Feature pages: src/content/pages with `kind: feature`, at /features/<id>/.
import SeoPage from '../../layouts/SeoPage.astro'
import { seoPages } from '../../lib/pages'

export async function getStaticPaths() {
  return (await seoPages('feature')).map((page) => ({ params: { slug: page.id }, props: { page } }))
}
const { page } = Astro.props
---

<SeoPage page={page} />
