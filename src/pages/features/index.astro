---
// The features hub, /features/: src/content/pages/features.md (`kind: hub`), in the same layout as every page.
import { getEntry } from 'astro:content'
import SeoPage from '../../layouts/SeoPage.astro'

const page = await getEntry('pages', 'features')
if (!page || page.data.kind !== 'hub') throw new Error('src/content/pages/features.md must exist with kind: hub')
---

<SeoPage page={page} />
