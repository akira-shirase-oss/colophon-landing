---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import styles from '../../components/Blog.module.css'
import { posts, formatDate } from '../../lib/posts'

const list = await posts()
const title = 'Blog | Colophon'
const description =
  'How Colophon proves what it published: releases, receipts, reviewed rollbacks and safe automation, explained from the code that does it.'
---

<Base
  title={title}
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Colophon blog',
    url: new URL('/blog/', Astro.site).href,
    description,
  }}
>
  <div style="display: flex; flex-direction: column; align-items: center; overflow: clip;">
    <Nav />
    <main class={styles.page}>
      <div class={styles.column}>
        <header class={styles.head}>
          <p class="t-badge">Blog</p>
          <h1 class="t-h2">Notes on publishing you can check</h1>
          <p class={`t-body ${styles.lede}`}>
            How Colophon works and why, written from the code that does it. The failures go in the{' '}
            <a href="https://404human.dev/colophon/">build log</a>.
          </p>
        </header>
        {
          list.length === 0 ? (
            <p class={`t-body ${styles.empty}`}>The first posts are on their way.</p>
          ) : (
            <ul class={styles.list}>
              {list.map((p) => (
                <li class={styles.item}>
                  <a href={`/blog/${p.id}/`}>
                    <span class={styles.stamp}>
                      <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                      {p.data.draft && <span class={styles.draft}>Draft</span>}
                    </span>
                    <h2 class={`t-h4 ${styles.itemTitle}`}>{p.data.title}</h2>
                    <p class={`t-body ${styles.itemDesc}`}>{p.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </main>
    <Footer />
  </div>
</Base>
