---
import { render } from 'astro:content'
import PostLayout from '../../layouts/Post.astro'
import { published, siteCopy } from '../../lib/home'
import { posts, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content } = await render(post)
---

<PostLayout id={post.id} data={post.data} source={post.body ?? ''} statusLine={(await siteCopy()).status_line} {...await published()}>
  <Content />
</PostLayout>
