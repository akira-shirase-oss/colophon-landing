---
// The comparisons hub, /compare/: src/content/pages/compare.md (`kind: hub`), in the same layout as every page.
import { getEntry } from 'astro:content'
import SeoPage from '../../layouts/SeoPage.astro'

const page = await getEntry('pages', 'compare')
if (!page || page.data.kind !== 'hub') throw new Error('src/content/pages/compare.md must exist with kind: hub')
---

<SeoPage page={page} />
