---
// The guides hub, /guides/: src/content/pages/guides.md (`kind: hub`), in the same layout as every page.
import { getEntry } from 'astro:content'
import SeoPage from '../../layouts/SeoPage.astro'

const page = await getEntry('pages', 'guides')
if (!page || page.data.kind !== 'hub') throw new Error('src/content/pages/guides.md must exist with kind: hub')
---

<SeoPage page={page} />
