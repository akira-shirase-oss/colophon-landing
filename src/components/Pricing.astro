---
import ArrowButton from './ui/ArrowButton.astro'
import styles from './Pricing.module.css'

type View = 'phase' | 'proof'

type Stage = {
  name: string
  value: Record<View, string>
  unit: Record<View, string>
  description: string
  features: { label: string; done: boolean }[]
  cta: { label: string; variant: 'primary' | 'secondary'; href: string }
  featured?: boolean
}

// Colophon has no pricing yet; these cards report build status instead, in the words of the
// milestone table in Colophon's README (Core is P0–P3, and P3's public demo is owed; Automation is P5,
// gate met; Operations is P6–P7, and P6's 24-hour soak, usability sessions and independent install
// are owed). Readers see words, not milestone codes. Values and units stay one line each: the cards
// have a fixed height.
const stages: Stage[] = [
  {
    name: 'Core',
    value: { phase: 'Built', proof: '1 seed' },
    unit: { phase: 'the public demo is still owed', proof: 'replays any failure exactly' },
    description: 'The base layer that every later phase builds on, built and covered by tests.',
    features: [
      { label: 'Numbered releases', done: true },
      { label: 'Pinned-release reads', done: true },
      { label: 'Reviewed rollbacks', done: true },
      { label: 'Locales and localization groups', done: true },
      { label: 'Email-and-password accounts', done: true },
      { label: 'Mirrored references', done: true },
      { label: 'Import and export', done: true },
      { label: 'Type builder', done: true },
    ],
    cta: { label: 'Read the build log', variant: 'secondary', href: 'https://404human.dev/colophon/' },
  },
  {
    name: 'Automation',
    value: { phase: 'Done', proof: '0' },
    unit: { phase: 'its safety gate passed', proof: 'unauthorized actions in the eval' },
    description: 'Tokens, budgets and quotas that keep scripts and AI agents inside clear limits.',
    features: [
      { label: 'No token self-approval', done: true },
      { label: 'Budgets reserved in Postgres', done: true },
      { label: 'Per-day cost ceilings', done: true },
      { label: 'Crash-safe bulk jobs', done: true },
      { label: 'Per-token request quotas', done: true },
      { label: 'CLI and MCP parity with the API', done: true },
      { label: 'Adversarial eval gate', done: true },
      { label: 'JSONL content export and import', done: true },
    ],
    cta: { label: 'See the source', variant: 'primary', href: 'https://github.com/akira-shirase-oss/colophon-cms' },
    featured: true,
  },
  {
    name: 'Operations',
    value: { phase: 'Built', proof: '400s' },
    unit: { phase: 'three gates are still owed', proof: 'from backup capture to serving' },
    description: 'Backups, load tests and member accounts, each exercised against real failures.',
    features: [
      { label: 'Encrypted backups', done: true },
      { label: 'Continuous WAL archiving', done: true },
      { label: '540,063-request load run', done: true },
      { label: '10,000-record import', done: true },
      { label: 'Argon2id member accounts', done: true },
      { label: 'Row-level visibility gates', done: true },
      { label: 'Hourly retention sweep', done: true },
      { label: '24-hour soak test', done: false },
    ],
    cta: { label: 'Open an issue', variant: 'secondary', href: 'https://github.com/akira-shirase-oss/colophon-cms/issues' },
  },
]

const views: { id: View; label: string }[] = [
  { id: 'phase', label: 'Status' },
  { id: 'proof', label: 'Proof' },
]
---

<section class="section" id="pricing">
  <div class={`container ${styles.inner}`}>
    <div class={styles.head}>
      <div class={styles.titleBadge}>
        <p class="t-badge">Status</p>
        <h2 class="t-h2">Where it stands, <span class="soft">with the evidence</span></h2>
      </div>
      <p class={`t-body ${styles.intro}`}>
        A phase only closes when its test results are stored. The 24-hour soak is the last open item in the
        <a class="inline-link" href="/blog/colophon-load-test-numbers/">load tests</a>.
      </p>
    </div>

    <div class={styles.plans} data-status>
      <div class={styles.tabsRow}>
        <div class={styles.tabs} role="radiogroup" aria-label="Show status or proof">
          <span class={styles.tabBg} aria-hidden="true" data-pill></span>
          {
            views.map((v, i) => (
              <button
                type="button"
                role="radio"
                aria-checked={String(i === 0)}
                class={styles.tab}
                data-active={String(i === 0)}
                data-view={v.id}
              >
                {v.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class={styles.row}>
        {
          stages.map((p) => (
            <article class={`${styles.card} ${p.featured ? styles.featured : ''}`}>
              {p.featured && <img class={styles.cardBg} src="/images/pricing-pro.webp" alt="" loading="lazy" />}
              <h3 class={`t-h4 ${styles.planName}`}>{p.name}</h3>
              <div class={styles.price}>
                <p class={`t-h3 ${styles.amount}`} data-phase={p.value.phase} data-proof={p.value.proof}>{p.value.phase}</p>
                <p class="t-body" data-phase={p.unit.phase} data-proof={p.unit.proof}>{p.unit.phase}</p>
              </div>
              <p class={`t-body ${styles.desc}`}>{p.description}</p>
              <ul class={styles.list}>
                {p.features.map((f) => (
                  <li class={styles.feature} data-included={String(f.done)}>
                    <span class={styles.square} aria-hidden="true" />
                    <span class="t-body">{f.label}{!f.done && <span class="visually-hidden"> (outstanding)</span>}</span>
                  </li>
                ))}
              </ul>
              <ArrowButton href={p.cta.href} variant={p.cta.variant} block>{p.cta.label}</ArrowButton>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Phase / Proof switch: swap each card's value and unit, and slide the white pill under the active label.
  const root = document.querySelector<HTMLElement>('[data-status]')!
  const pill = root.querySelector<HTMLElement>('[data-pill]')!
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')]
  const values = [...root.querySelectorAll<HTMLElement>('[data-phase]')]

  const show = (view: string) => {
    for (const tab of tabs) {
      const on = tab.dataset.view === view
      tab.setAttribute('aria-checked', String(on))
      tab.dataset.active = String(on)
      if (on) {
        pill.style.left = `${tab.offsetLeft}px`
        pill.style.width = `${tab.offsetWidth}px`
      }
    }
    for (const el of values) el.textContent = el.dataset[view as 'phase' | 'proof']!
  }
  for (const tab of tabs) tab.addEventListener('click', () => show(tab.dataset.view!))
  show('phase')
</script>
