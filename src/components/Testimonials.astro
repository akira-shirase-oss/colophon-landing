---
import styles from './Testimonials.module.css'

// Colophon has no users yet, so this section quotes its own build log instead of customers.
// Each quote is verbatim from the linked post (404human.dev), with the post's title and date.
const entries = [
  {
    quote:
      "Here's a pattern that lives in thousands of codebases: read a counter, then write it back. It looks safe. It isn't — and Colophon's publish path just proved it the hard way.",
    title: 'The deadlock that only exists when two people publish at once',
    date: '5 Nov 2026',
    href: 'https://404human.dev/posts/postgres-lock-upgrade-deadlock/',
  },
  {
    quote:
      'Crash bugs usually hide in the messy middle — half-done batches, partial writes. This one hid in the cleanest possible state: everything already finished.',
    title: 'The bug hiding in the “nothing to do” path',
    date: '5 Nov 2026',
    href: 'https://404human.dev/posts/bug-in-the-nothing-to-do-path/',
  },
  {
    quote:
      "Most codebases add a throttle and call it done. Colophon's spec asks for something harder — a measurement. Throttle the noisy agent, then prove the editors beside it keep their latency.",
    title: 'Proving a noisy neighbor stays quiet',
    date: '5 Nov 2026',
    href: 'https://404human.dev/posts/noisy-agent-measured-isolation/',
  },
]
---

<section class="section">
  <div class={`container ${styles.inner}`}>
    <h2 class="visually-hidden">From the build log</h2>

    <ul class={styles.grid}>
      {
        entries.map((e) => (
          <li>
            <a class={styles.card} href={e.href} target="_blank" rel="noreferrer">
              <img class={styles.hoverBg} src="/images/review-bg.webp" alt="" loading="lazy" aria-hidden="true" />
              <blockquote class={styles.quote}>{e.quote}</blockquote>
              <div class={styles.bottom}>
                <span class={styles.stamp}>Build log · {e.date}</span>
                <span class="t-h5">{e.title}</span>
                <span class={styles.readOn}>Read the post →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
