---
import styles from './Integrations.module.css'

// icon order per row, as on the source page
const rows = [
  { icons: [1, 2, 3, 4, 5, 6, 7, 8], dir: 'right' as const },
  { icons: [4, 5, 3, 2, 8, 6, 1, 7], dir: 'left' as const },
]
---

<section class="section">
  <div class={`container ${styles.inner}`}>
    <div class={styles.head}>
      <div class={styles.titleBadge}>
        <p class="t-badge">For developers</p>
        <h2 class="t-h2">One API, every surface. <span class="soft">Same rules on each.</span></h2>
      </div>
      <p class={`t-body ${styles.intro}`}>
        REST, GraphQL, the TypeScript SDK, the CLI and an MCP server all follow the same permissions. Test a Strapi or
        Sanity import before you commit to it.
      </p>
    </div>

    <div class={styles.animation} aria-hidden="true">
      {
        rows.map((row) => (
          <div class={styles.row}>
            <div class={`${styles.track} ${row.dir === 'right' ? styles.toRight : styles.toLeft}`}>
              {[0, 1].map(() => (
                <ul class={styles.list}>
                  {row.icons.map((n) => (
                    <li class={styles.icon}>
                      <img src={`/integrations/icon-${n}.svg`} alt="" width="96" height="96" />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
