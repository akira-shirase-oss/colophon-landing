---
import MaskIcon from './ui/MaskIcon.astro'
import BrandLogo from './ui/BrandLogo.astro'
import BrandWordmark from './ui/BrandWordmark.astro'
import styles from './Footer.module.css'

const columns = [
  { title: 'Product', links: ['Features', 'Status', 'Demo sites'] },
  { title: 'Build', links: ['Build log', 'Contact'] },
  { title: 'Legal', links: ['Privacy', 'Terms'] },
]

const socials = [
  { icon: '/icons/x.svg', label: 'X', href: 'https://x.com/' },
  { icon: '/icons/threads.svg', label: 'Threads', href: 'https://www.threads.com/' },
  { icon: '/icons/linkedin.svg', label: 'LinkedIn', href: 'https://www.linkedin.com/' },
]
---

<footer class={styles.footer}>
  <div class={styles.inner}>
    <div class={styles.top}>
      <a href="#" aria-label="Colophon home">
        <BrandLogo />
      </a>
      <div class={styles.social}>
        <p class="t-tiny">Social media</p>
        <div class={styles.socialButtons}>
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} class={styles.socialBtn}>
                <MaskIcon src={s.icon} size={24} color="var(--c-ink)" />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class={styles.links}>
      <p class={`t-tiny ${styles.tagline}`}>
        Publishing you can check afterwards. Every release is recorded and every change can be reviewed.
      </p>
      <nav class={styles.menu} aria-label="Footer">
        {
          columns.map((c) => (
            <div class={styles.column}>
              <p class={`t-label ${styles.colTitle}`}>
                <span class={styles.square} aria-hidden="true" />
                {c.title}
              </p>
              {c.links.map((l) => (
                <a href="#" class={`t-tiny ${styles.link}`}>
                  {l}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </div>

    <div class={styles.wordmark}>
      <BrandWordmark class={styles.wordmarkImg} />
      <img class={styles.mosaic} src="/images/mosaic-footer.png" alt="" aria-hidden="true" />
      <div class={styles.legal}>
        <p class="t-small">© 2026 Colophon · Made with <a href="#">Rust and Svelte</a></p>
        <a href="#" class="t-small" style="color: var(--c-ink);">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
