---
import Badge from './ui/Badge.astro'
import Button from './ui/Button.astro'
import MaskIcon from './ui/MaskIcon.astro'
import { jsonLd } from '../lib/json-ld'
import type { HomeCopy } from '../lib/schemas'
import styles from './FAQ.module.css'

type Props = { copy: Pick<HomeCopy, 'faq'> }
const faqs = Astro.props.copy.faq

// FAQPage structured data: lets search engines show these answers directly in results.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<section class={styles.section}>
  <div class={styles.inner}>
    <div class={styles.left}>
      <div class={styles.titleBadge}>
        <Badge as="p" tone="brand">FAQ</Badge>
        <h2 class={styles.h2}>
          Questions
          <br />
          answered
        </h2>
      </div>
      <div class={styles.cta}>
        <p class={styles.ctaText}>Still curious?</p>
        <Button href="https://github.com/akira-shirase-oss/colophon-cms/issues" variant="primary">Open an issue</Button>
      </div>
    </div>

    <div class={styles.list} data-faq>
      {
        faqs.map((f) => (
          <div class={styles.item} data-open="false">
            <button type="button" class={styles.question} aria-expanded="false">
              <span class={styles.q}>{f.q}</span>
              <span class={styles.icon} aria-hidden="true">
                <MaskIcon class={styles.plus} src="/icons/plus.svg" size={24} color="var(--foreground)" />
                <MaskIcon class={styles.close} src="/icons/close.svg" size={18} color="var(--foreground)" />
              </span>
            </button>
            <div class={styles.answer}>
              <div>
                <p class={styles.a}>{f.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={jsonLd(faq)} />

<script>
  // One answer open at a time; clicking the open question closes it.
  const items = [...document.querySelectorAll<HTMLElement>('[data-faq] > div')]
  items.forEach((item) =>
    item.querySelector('button')!.addEventListener('click', () => {
      const opening = item.dataset.open !== 'true'
      for (const other of items) {
        const on = opening && other === item
        other.dataset.open = String(on)
        other.querySelector('button')!.setAttribute('aria-expanded', String(on))
      }
    }),
  )
</script>
