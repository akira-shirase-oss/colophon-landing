---
/** The oversized "Colophon" at the foot of every page, set in Geist Pixel's own cells (wordmark-cells.ts,
 * generated from the shipped font), like a receipt printer's dots: every publish leaves a receipt. One path
 * of separate squares with the hairline between them drawn in, so there is no mask to paint. Decorative: the name
 * is already in the footer. It is there from the first paint: nothing waits for a scroll (the maintainer's call). */
import { wordmark } from './wordmark-cells'

type Props = { class?: string }
const { class: className } = Astro.props
---

<svg
  class={className}
  viewBox={`0 0 ${wordmark.width} ${wordmark.height}`}
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
  data-wordmark
  style={`--rows: ${wordmark.capRows + 1}`}
>
  <path class="cells" d={wordmark.path} style="fill: var(--c-wordmark)"></path>
</svg>

<style>
  /* Phones: the cells are a few pixels wide and the gap a fraction of one, so let it blend rather than snap. */
  @media (max-width: 809px) {
    svg {
      shape-rendering: geometricPrecision;
    }
  }
</style>
