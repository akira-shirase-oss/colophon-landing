---
import Button from './Button.astro'

type Props = {
  href: string
  variant?: 'primary' | 'secondary' | 'onBrand'
  /** stretch to the parent's width */
  block?: boolean
  size?: 'sm' | 'default' | 'lg'
}

/**
 * A link that goes somewhere: the Studio's button (Button.astro) with the site's pixel arrow after the label.
 * `onBrand` is the primary on the hero's brand block; it reads the same as `primary` and is kept as a name so
 * callers say where the button sits.
 */
const { href, variant = 'primary', block = false, size = 'default' } = Astro.props
---

<Button href={href} variant={variant === 'secondary' ? 'secondary' : 'primary'} size={size} block={block} arrow>
  <slot />
</Button>
