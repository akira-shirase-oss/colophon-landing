---
import Button from './Button.astro'

type Props = {
  href: string
  variant?: 'primary' | 'secondary' | 'onBrand'
  /** onBrand: the navy focus edge, for a button on the hero's gradient */
  focus?: 'ring' | 'onBrand'
  /** stretch to the parent's width */
  block?: boolean
  size?: 'sm' | 'default' | 'lg'
}

/**
 * A link that goes somewhere: the Studio's button (Button.astro) with the site's pixel arrow after the label.
 */
const { href, variant = 'primary', block = false, size = 'default', focus = 'ring' } = Astro.props
---

<Button href={href} variant={variant} size={size} focus={focus} block={block} arrow>
  <slot />
</Button>
