---
import Badge from './ui/Badge.astro'
import Card from './ui/Card.astro'
import { BENEFIT_ICONS } from '../data/home'
import type { HomeCopy } from '../lib/schemas'
import styles from './Benefits.module.css'

type Props = { copy: Pick<HomeCopy, 'benefits'> }
const { copy } = Astro.props

// The icons a card can name (lucide-style, one stroke): the words and the choice of icon and tone are the `home`
// entry's; the drawings stay here.
const ICONS: Record<(typeof BENEFIT_ICONS)[number], string> = {
  'file-check': '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m9 15 2 2 4-4"/>',
  'dice': '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.25"/><circle cx="12" cy="12" r="1.25"/><circle cx="15.5" cy="15.5" r="1.25"/>',
  'history': '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  'receipt': '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-8"/><path d="M16 12h-8"/><path d="M12 16H8"/>',
  'shield-check': '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  'bot': '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
}
const cards = copy.benefits.map((c) => ({ title: c.title, lines: [c.line_one, c.line_two], tag: c.tag, tone: c.tone, icon: ICONS[c.icon] }))
---

<section class={styles.section} id="benefits">
  <div class={styles.inner}>
    <h2 class={styles.vh}>Why Colophon</h2>

    <ul class={styles.grid} data-why>
      {
        cards.map((c) => (
          <Card as="li" class={styles.card}>
            <div class={styles.titleRow}>
              <span class={styles.icon} aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="30"
                  height="30"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={c.icon}
                />
              </span>
              <h3 class={styles.cardTitle}>{c.title}</h3>
            </div>
            <p class={styles.body}>
              <span>{c.lines[0]}</span> <span>{c.lines[1]}</span>
            </p>
            <Badge tone={c.tone} dot class={styles.tag}>
              {c.tag}
            </Badge>
          </Card>
        ))
      }
    </ul>
  </div>
</section>
