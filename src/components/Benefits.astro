---
import SectionHeading from './ui/SectionHeading.astro'
import styles from './Benefits.module.css'

const cards = [
  {
    title: 'Lose nothing',
    body: 'Pull the plug in the middle of a save and your work is still there. A publish lands once and completely, or it does not land at all.',
  },
  {
    title: 'Replayable bugs',
    body: 'When a test run finds a problem, it hands back a seed number. Run that seed and you get the exact same failure again, every time, until it is fixed.',
  },
  {
    title: 'Time travel',
    body: 'Scrub back to any release and see the site exactly as readers saw it that day. Going back is simply a new release.',
  },
  {
    title: 'Honest status',
    body: 'A page only counts as published once readers can see it. Until then, Colophon shows it as pending.',
  },
]
const initiallyOpen = 1
---

<section class="section" id="benefits">
  <div class={`container ${styles.inner}`}>
    <div class={styles.head}>
      <SectionHeading badge="Why Colophon">
        The four promises
        <br />
        Colophon keeps on every change
      </SectionHeading>
      <p class={`t-body ${styles.intro}`}>
        Most tools trust their own progress bars. Colophon checks itself against these four promises with simulated
        crashes and network faults on every change.
      </p>
    </div>

    <div class={styles.row} data-benefits>
      {
        cards.map((c, i) => {
          const isOpen = i === initiallyOpen
          return (
            <article class={styles.card} data-open={String(isOpen)} tabindex="0">
              <div class={styles.closed} aria-hidden={String(isOpen)}>
                <p class={styles.num}>0{i + 1}.</p>
                <div class={styles.closedImg}>
                  <img src={`/images/benefit-${i + 1}-closed.png`} alt="" loading="lazy" />
                </div>
                <h3 class="t-h5">{c.title}</h3>
              </div>
              <div class={styles.opened} aria-hidden={String(!isOpen)}>
                <div class={styles.openImg}>
                  <img src={`/images/benefit-${i + 1}-open.png`} alt="" loading="lazy" />
                </div>
                <div class={styles.openContent}>
                  <h3 class="t-h3">{c.title}</h3>
                  <p class="t-small" style="white-space: pre-line;">
                    {c.body}
                  </p>
                </div>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  // Hovering (or focusing) a card opens it, and it stays open.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-benefits] > article')]
  const open = (target: HTMLElement) => {
    for (const card of cards) {
      const isOpen = card === target
      card.dataset.open = String(isOpen)
      card.children[0].setAttribute('aria-hidden', String(isOpen))
      card.children[1].setAttribute('aria-hidden', String(!isOpen))
    }
  }
  for (const card of cards) {
    card.addEventListener('mouseenter', () => open(card))
    card.addEventListener('focus', () => open(card))
  }
</script>
