---
import ArrowButton from './ui/ArrowButton.astro'
import styles from './Hero.module.css'

// What Colophon is actually built on, set as plain words (no customer logos: it has no users yet)
const stack = ['Rust', 'Svelte', 'PostgreSQL', 'Valkey', 'TypeScript']
---

<section class={styles.hero}>
  <div class={styles.card}>
    <div class={styles.bg} aria-hidden="true" data-scroll-zoom></div>
    <div class={styles.overlay} aria-hidden="true"></div>
    <div class={styles.title}>
      <h1 class="t-hero">
        A CMS where every publish leaves a&nbsp;receipt
      </h1>
      <p class={`t-body ${styles.sub}`}>
        Write, review and ship your site's articles, then see exactly what went live, when it went live, and where
        readers saw it.
      </p>
      <ArrowButton href="#">See a demo site</ArrowButton>
    </div>
  </div>
</section>

<section class={styles.trusted}>
  <p class="t-small" style="color: var(--c-ink);">Built in the open with</p>
  <ul class={styles.logos}>
    {stack.map((name) => <li class={styles.logoBox}>{name}</li>)}
  </ul>
</section>

<script>
  // Writes --zoom on the hero painting, 1.5x -> 3.9x across the whole page's scroll range.
  const el = document.querySelector<HTMLElement>('[data-scroll-zoom]')!
  const from = 1.5
  const to = 3.9
  let frame = 0
  const update = () => {
    frame = 0
    const max = document.documentElement.scrollHeight - window.innerHeight
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0
    el.style.setProperty('--zoom', String(from + (to - from) * p))
  }
  const onScroll = () => {
    if (!frame) frame = requestAnimationFrame(update)
  }
  update()
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onScroll)
</script>
