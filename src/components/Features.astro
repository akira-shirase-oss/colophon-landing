---
// "What's built": one card per capability, the text beside a Studio window. Each window is
// Colophon's own UI, not a picture of it: the components in src/studio-ui/ are copied from the
// Colophon repository and rendered here at build time with sample data. Nothing in them is
// hydrated, so they add no JavaScript; the window is `inert` and hidden from screen readers,
// and its figure caption says what it shows.
import '../studio-ui/studio.css'
import ApiTokens from '../studio-ui/screens/ApiTokens.svelte'
import MediaLibrary from '../studio-ui/screens/MediaLibrary.svelte'
import RollbackReview from '../studio-ui/screens/RollbackReview.svelte'
import SiteBuilder from '../studio-ui/screens/SiteBuilder.svelte'
import { contrast, STARTER_THEME } from '../studio-ui/site-renderer.ts'
import styles from './Features.module.css'

// A small status card that floats over the window. Every line is true of Colophon today (docs/modules on GitHub).
type Receipt = {
  label: string
  status: string
  tone: 'green' | 'blue'
  title: string
  rows: [string, string][]
  /** what a screen reader hears instead of the card's parts */
  says: string
}

type Item = {
  title: string
  body: string
  /** the window's figure caption: what the illustration shows */
  caption: string
  screen: typeof SiteBuilder
  /** where "Learn more" goes, and the words a screen reader adds after "Learn more" */
  href: string
  topic: string
  receipt: Receipt
}

const docs = 'https://github.com/akira-shirase-oss/colophon-cms/blob/main/docs/modules'

// The starter theme's contrast pairs, computed the way the Studio's design sheet (ThemeLook) does.
const light = STARTER_THEME.light as Record<string, string>
const ratio = (fg: string, bg: string) => `${contrast(fg, bg).toFixed(1)}:1`

const items: Item[] = [
  {
    title: 'Sites without custom CSS',
    body: 'Build pages, menus and themes from a fixed set of sections and design tokens, then publish them like any article.',
    caption:
      "Colophon Studio's site builder: the Home page's Look tab shows the page rendered from its sections and the site theme, beside the panel that sends it for review.",
    screen: SiteBuilder,
    href: `${docs}/15-web-blog.md`,
    topic: 'the website builder in the module notes on GitHub',
    receipt: {
      label: 'Theme',
      status: 'Passes AA',
      tone: 'green',
      title: 'Site theme',
      rows: [
        ['Body text', ratio(light.text, light.surface)],
        ['Buttons', ratio('#ffffff', light.primary)],
        ['Taglines', ratio(light.muted, light.surface)],
      ],
      says: `The starter theme's contrast, checked as it is edited: body text ${ratio(light.text, light.surface)}, buttons ${ratio('#ffffff', light.primary)}, taglines ${ratio(light.muted, light.surface)}, each at least the 4.5:1 that WCAG AA asks for.`,
    },
  },
  {
    title: "Media that can't break a page",
    body: 'Every upload is checked before it can be published, so a release never goes out pointing at a broken image.',
    caption: "Colophon Studio's media library: five uploads with their sizes, four marked Usable after their checks and one still being checked.",
    screen: MediaLibrary,
    href: `${docs}/07-media.md`,
    topic: 'how uploads are checked in the module notes on GitHub',
    receipt: {
      label: 'Upload',
      status: 'Verified',
      tone: 'green',
      title: 'lavender-farmhouse.webp',
      rows: [
        ['Type', 'WebP, read from the file'],
        ['Metadata', 'Stripped'],
        ['Renditions', 'w320, w1280'],
      ],
      says: 'Example upload lavender-farmhouse.webp, verified: its type read from the file as WebP, metadata stripped, renditions w320 and w1280 made.',
    },
  },
  {
    title: 'Rollbacks that get reviewed',
    body: 'Returning to an older version opens a normal change for review instead of skipping the process.',
    caption:
      "Colophon Studio's publish request for a rollback to release 144, waiting for review: the entries it restores, its review stages and the review panel.",
    screen: RollbackReview,
    href: '/blog/roll-back-a-bad-publish/',
    topic: 'reviewed rollbacks on the blog',
    receipt: {
      label: 'Publish request',
      status: 'In review',
      tone: 'blue',
      title: 'Rollback to release 144',
      rows: [
        ['Live now', 'Release 145'],
        ['Once approved', 'Release 146'],
        ['Review', 'Same as any publish'],
      ],
      says: 'Example publish request "Rollback to release 144", in review. Release 145 is live now; once approved, the rollback goes live as release 146, reviewed like any publish.',
    },
  },
  {
    title: 'Generated API docs and SDK',
    body: "The API document is generated from the server's own route table, and the TypeScript SDK's types from that document.",
    caption:
      "Colophon Studio's API tokens settings: scoped tokens for a site build, a writing assistant and an import script, each with its powers and end date.",
    screen: ApiTokens,
    href: `${docs}/13-sdk.md`,
    topic: 'the generated SDK in the module notes on GitHub',
    receipt: {
      label: 'API document',
      status: 'Generated',
      tone: 'green',
      title: 'openapi.json',
      rows: [
        ['Source', "The server's route table"],
        ['SDK types', 'api.types.ts'],
        ['CLI and MCP', 'The same /api/v1'],
      ],
      says: "Example API document openapi.json, generated from the server's route table. The SDK's types are generated from it, and the CLI and MCP tools use the same API.",
    },
  },
]
---

<section class="section" id="features">
  <div class="container">
    <h2 class="visually-hidden">What's built</h2>

    <ul class={styles.list}>
      {
        items.map((it, i) => (
          <li class={`${styles.card} ${i % 2 === 1 ? styles.flip : ''}`}>
            <div class={styles.text}>
              <h3 class={styles.title}>{it.title}</h3>
              <p class={styles.body}>{it.body}</p>
              <a class={styles.more} href={it.href}>
                Learn more<span class="visually-hidden"> about {it.topic}</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 16 16"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </a>
            </div>

            <div class={styles.stage}>
              <div class={styles.panel}>
                <figure class={styles.window}>
                  <div class={styles.bar} aria-hidden="true">
                    <span class={styles.dots}>
                      <span />
                      <span />
                      <span />
                    </span>
                    <span class={styles.address}>Colophon Studio</span>
                  </div>
                  <div class={styles.screen} inert aria-hidden="true">
                    <div class={`studio ${styles.studio}`}>
                      <it.screen />
                    </div>
                  </div>
                  <figcaption class="visually-hidden">{it.caption}</figcaption>
                </figure>
              </div>

              <div class={styles.receipt} role="img" aria-label={it.receipt.says}>
                <div class={styles.receiptHead}>
                  <span class={styles.receiptLabel}>{it.receipt.label}</span>
                  <span class={`${styles.status} ${styles[it.receipt.tone]}`}>
                    <span class={styles.dot} />
                    {it.receipt.status}
                  </span>
                </div>
                <p class={styles.receiptTitle}>{it.receipt.title}</p>
                <dl class={styles.rows}>
                  {it.receipt.rows.map(([k, v]) => (
                    <div>
                      <dt>{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
