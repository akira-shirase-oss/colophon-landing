---
// The shared status line under every post's title: `line` is the `site` entry's (the page that renders the post
// reads it, src/lib/home.ts). A post may add one sentence of its own (frontmatter `status`) saying what is still
// missing for its topic.
import styles from './Blog.module.css'

type Props = { line: string; note?: string }
const { line, note } = Astro.props
const status = {
  line,
  /** Where a reader goes for what's done and what broke. */
  done: { href: 'https://github.com/akira-shirase-oss/colophon-cms/blob/main/docs/ROADMAP.md', text: 'what’s built' },
  log: { href: 'https://404human.dev/colophon/', text: 'the build log' },
}
// Astro drops whitespace between lines of markup, so the spaces between the parts are explicit.
const text = note ? `${status.line} ${note}` : status.line
---

<p class={styles.status}>
  <strong>Status.</strong>{' '}{text}{' '}See <a href={status.done.href}>{status.done.text}</a> and{' '}
  <a href={status.log.href}>{status.log.text}</a>.
</p>
