---
// The shared status line under every post's title, fed from src/data/status.ts. A post may add one
// sentence of its own (frontmatter `status`) saying what is still missing for its topic.
import { status } from '../data/status'
import styles from './Blog.module.css'

type Props = { note?: string }
const { note } = Astro.props
---

<p class={styles.status}>
  <strong>Status.</strong>
  {status.line}
  {note && <> {note}</>}
  See <a href={status.done.href}>{status.done.text}</a> and <a href={status.log.href}>{status.log.text}</a>.
</p>
