---
import ArrowButton from './ui/ArrowButton.astro'
import styles from './CTA.module.css'
---

<section class={styles.section}>
  <div class={`brand-block ${styles.card}`}>
    <div class={styles.title}>
      <h2 class={`t-h2 ${styles.heading}`}>
        Follow the build.
        <br />
        <span class={styles.soft}>Mistakes included</span>
      </h2>
      <p class={`t-body ${styles.sub}`}>
        Colophon is being built in public, one write-up at a time. Read along as it comes together, or poke around the
        demo sites.
      </p>
      <ArrowButton href="https://404human.dev/colophon/" variant="onBrand">Read the build log</ArrowButton>
    </div>
  </div>
</section>
