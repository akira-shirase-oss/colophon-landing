# Security headers for every response from Cloudflare Pages
# (syntax: https://developers.cloudflare.com/pages/configuration/headers/).
# `npm run build && npm run check` fails if a header is missing or the policy no longer fits the pages.
#
# Content-Security-Policy, one directive at a time:
#   default-src 'none'   nothing loads unless a directive below allows it
#   script-src           same-origin files plus the SHA-256 of each inline <script> Astro emits. When a
#                        component script changes, the check prints the new hash: review the script, then
#                        swap the hash here. JSON-LD blocks (exactly type="application/ld+json") are data
#                        the browser never runs, so they need none; any other unknown type fails the check.
#                        Plus https://static.cloudflareinsights.com: Cloudflare Web Analytics' beacon (below).
#   connect-src          'self' and https://cloudflareinsights.com: where the beacon reports (on this proxied
#                        site it posts to /cdn-cgi/rum on the same origin; the second is Cloudflare's own host)
#   style-src            'unsafe-inline' because Shiki colours code with style attributes and Astro
#                        inlines small stylesheets. Adding a hash here would switch 'unsafe-inline' off.
#   img-src, font-src    the site's own files only: images and fonts are self-hosted
#   base-uri, form-action, frame-ancestors   'none': no <base>, no forms, never framed
# Cloudflare Web Analytics (maintainer, 19 November 2026) is the one third party: cookieless page views and
# real-user Core Web Vitals, which search needs and lab tests can't give. Cloudflare adds its beacon to each
# page; the policy allows exactly its two origins and nothing else, and `npm run check` fails on any other
# origin (scripts/check-dist.mjs, ANALYTICS). Rocket Loader and Zaraz add scripts this policy blocks: leave
# them off. No other analytics, tag managers or pixels.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-OleRWtzt+z65gBiAAcIonlLlMAQ/p3JP0uS+9ExioNw=' 'sha256-GqyWw6Bz0OFkhVgwPXvXde6PM9kwOr1TWH4JVKhBMts=' 'sha256-jcGxqr5df3Yhy0nzg+sEMXDaoMkTSBu+zNSbj1FavsI=' 'sha256-WUobdz2TlVpknTILgEcGwp2aLMGZ2VhUKoQOLtu/7fM=' 'sha256-ZVOlaHTzKWn0aw/7SlZpzUC33YyUIXuq0yXJ4oNhCNE=' 'sha256-fzo6tqKbqpRaTeBruxvR4ab0IZIfa2qdW4yDAnVVCiA=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cloudflareinsights.com; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
